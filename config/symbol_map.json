{
  "preserve": {
    "「": "「",
    "」": "」",
    "『": "『",
    "』": "』",
    "…": "…"
  },
  "convert": {
    "、": ",",
    "。": ".",
    "！": "!",
    "？": "?",
    "（": "(",
    "）": ")",
    "・": "·",
    "〜": "~"
  },
  "forbidden_substitutions": {
    "「」": ["\"\"", "\u201c\u201d", "\u201e\u201c"],
    "『』": ["''", "\u2018\u2019"]
  },
  "page_number_pattern": "^\\d{1,3}$"
}
